{{template "layout.gohtml" .}}

{{define "title"}}Admin - Links{{end}}

{{define "content"}}
<div class="bg-white border-b border-slate-100 px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-2 text-primary text-xs font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-[16px]">admin_panel_settings</span>
        <span>Admin Panel</span>
    </div>
    <div class="flex items-center gap-2">
        <span
            class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
            <span class="material-symbols-outlined text-[14px]">link</span>
            {{len .Links}} links
        </span>
    </div>
</div>

<div class="px-6 sm:px-10 pt-8 pb-4">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 mb-2">Links Management</h1>
    <p class="text-slate-500 text-sm leading-relaxed max-w-md">
        All links generated on this server. Click on any link to view its details.
    </p>
</div>

<div class="px-6 sm:px-10 pb-6">
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-900 mb-4">Create New Link</h3>
        <form action="/admin/links" method="post" class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="flex-1 w-full space-y-1.5">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Expires In</label>
                <select name="expires_in"
                    class="w-full h-10 px-3 rounded-lg border border-slate-200 bg-slate-50 text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                    <option value="1h">1 Hour</option>
                    <option value="24h" selected>24 Hours</option>
                    <option value="168h">7 Days</option>
                    <option value="never">Never</option>
                </select>
            </div>
            <div class="flex gap-2 w-full sm:w-auto mt-2 sm:mt-0">
                <button type="submit" name="type" value="share"
                    class="flex-1 sm:flex-none h-10 px-4 rounded-lg bg-green-600 hover:bg-green-700 text-white font-semibold text-sm shadow-md shadow-green-600/20 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">share</span>
                    Create Share
                </button>
                <button type="submit" name="type" value="drop"
                    class="flex-1 sm:flex-none h-10 px-4 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-md shadow-blue-600/20 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">cloud_upload</span>
                    Create Drop
                </button>
            </div>
        </form>
    </div>
</div>

<div class="px-6 sm:px-10 pb-2">
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-slate-900">All Links</h3>
    </div>
    <div class="flex flex-col gap-3">
        {{range .Links}}
        <a href="/admin/links/{{.ID}}"
            class="group flex items-center gap-4 bg-white border border-slate-100 p-3 rounded-lg hover:border-slate-300 transition-colors shadow-sm">
            {{if eq .Metadata.Type "share"}}
            <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-green-50 text-green-600 border border-green-100">
                <span class="material-symbols-outlined text-[20px]">share</span>
            </div>
            {{else}}
            <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 border border-blue-100">
                <span class="material-symbols-outlined text-[20px]">cloud_upload</span>
            </div>
            {{end}}
            <div class="flex flex-col flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                    <p class="text-sm font-medium text-slate-900 font-mono truncate">{{.ID}}</p>
                    {{if eq .Metadata.Type "share"}}
                    <span
                        class="inline-flex shrink-0 rounded-full px-2 py-px text-[10px] font-semibold leading-4 bg-green-100 text-green-700">share</span>
                    {{else}}
                    <span
                        class="inline-flex shrink-0 rounded-full px-2 py-px text-[10px] font-semibold leading-4 bg-blue-100 text-blue-700">drop</span>
                    {{end}}
                </div>
                <div class="flex items-center gap-3 text-xs text-slate-400">
                    <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[12px]">schedule</span>
                        <time datetime="{{.Metadata.CreatedAt.Format " 2006-01-02T15:04:05Z07:00"}}"
                            class="local-time">{{.Metadata.CreatedAt.Format "2006-01-02 15:04 MST"}}</time>
                    </span>
                    {{if not .Metadata.ExpiresAt.IsZero}}
                    <span class="flex items-center gap-1 {{if .IsExpired}}text-red-500 font-medium{{end}}">
                        <span class="material-symbols-outlined text-[12px]">timer</span>
                        <time datetime="{{.Metadata.ExpiresAt.Format " 2006-01-02T15:04:05Z07:00"}}"
                            class="local-time">{{.Metadata.ExpiresAt.Format "2006-01-02 15:04 MST"}}</time>
                        {{if .IsExpired}} (Expired){{end}}
                    </span>
                    {{else}}
                    <span class="text-slate-300">No expiry</span>
                    {{end}}
                    <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[12px]">draft</span>
                        {{len .Files}} files
                    </span>
                </div>
            </div>
            <div
                class="h-8 w-8 flex items-center justify-center rounded-full text-slate-300 group-hover:bg-primary/10 group-hover:text-primary transition-all shrink-0">
                <span
                    class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-0.5">arrow_forward</span>
            </div>
        </a>
        {{else}}
        <div class="flex flex-col items-center justify-center py-12 text-center">
            <div class="h-14 w-14 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-4">
                <span class="material-symbols-outlined text-[28px]">link_off</span>
            </div>
            <p class="text-lg font-medium text-slate-900">No links found</p>
            <p class="text-sm text-slate-500 mt-1">Get started by creating a new share or drop link.</p>
        </div>
        {{end}}
    </div>
</div>

<div class="p-6 sm:p-10 bg-white mt-2 pt-4">
    <div class="mt-4 flex items-start gap-3 opacity-80">
        <span class="material-symbols-outlined text-[16px] text-slate-400 mt-0.5">info</span>
        <p class="text-xs text-slate-500 leading-normal">
            Links are sorted by newest first. Click any link to view its details in a new tab.
        </p>
    </div>
</div>
{{end}}