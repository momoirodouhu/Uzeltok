{{template "layout.gohtml" .}}

{{define "title"}}404 Not Found - Uzeltok{{end}}

{{define "content"}}
<div class="px-6 sm:px-10 py-16 flex flex-col items-center justify-center text-center">
    <div class="h-24 w-24 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 border border-slate-200 shadow-sm mb-6 group transition-all duration-300 hover:border-primary/30 hover:bg-slate-50">
        <span class="material-symbols-outlined text-[48px] text-slate-400 group-hover:text-primary transition-colors">sentiment_dissatisfied</span>
    </div>
    
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-2">404</h1>
    <h2 class="text-xl font-bold tracking-tight text-slate-700 mb-4">Page Not Found</h2>
    
    <p class="text-slate-500 text-sm leading-relaxed max-w-sm mb-8">
        The link you are trying to access doesn't exist, has expired, or the file was removed.
    </p>

    <a href="/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 font-bold px-6 py-3 shadow-sm transition-all duration-200">
        <span class="material-symbols-outlined text-[20px]">home</span>
        <span>Back to Home</span>
    </a>
</div>
{{end}}
