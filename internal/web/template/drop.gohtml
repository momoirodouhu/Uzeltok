{{template "layout.gohtml" .}}

{{define "title"}}Upload - Uzeltok{{end}}

{{define "content"}}
<div class="bg-white border-b border-slate-100 px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-2 text-primary text-xs font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-[16px]">cloud_upload</span>
        <span>File Upload</span>
    </div>
    <div class="flex items-center gap-2">
        <span class="text-xs text-slate-400 font-medium">Link ID:</span>
        <span class="text-xs font-mono text-slate-600 bg-slate-50 border border-slate-100 px-2 py-0.5 rounded">
            {{.Host}}/{{.ID}}
        </span>
    </div>
</div>
<div class="px-6 sm:px-10 pt-8 pb-4">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 mb-2">Quick Upload</h1>
    <p class="text-slate-500 text-sm leading-relaxed max-w-md">
        You've been invited to upload files to this server. Drag and drop below.
    </p>
</div>
{{if eq .Success "upload"}}
<div class="px-6 sm:px-10 mb-2 mt-4">
    <div
        class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl shadow-sm">
        <span class="material-symbols-outlined text-[20px] text-green-500">check_circle</span>
        <p class="text-sm font-medium">Upload successful!</p>
    </div>
</div>
{{end}}
<form action="/{{.ID}}/files" method="post" enctype="multipart/form-data">
    <div class="px-6 sm:px-10 py-4">
        <div class="relative group cursor-pointer">
            <div
                class="absolute -inset-0.5 bg-gradient-to-r from-primary to-[#1a6e80] rounded-xl opacity-0 group-hover:opacity-10 transition duration-500 blur">
            </div>
            <div
                class="relative flex flex-col items-center justify-center gap-4 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50/50 px-6 py-10 transition-all group-hover:border-primary/50 group-hover:bg-white">
                <div
                    class="h-14 w-14 rounded-full bg-white border border-slate-100 flex items-center justify-center text-slate-400 group-hover:text-primary group-hover:scale-110 transition-transform duration-300 shadow-sm">
                    <span class="material-symbols-outlined text-[28px]">cloud_upload</span>
                </div>
                <div class="flex flex-col items-center gap-1 text-center" id="upload-prompt">
                    <p class="text-slate-900 text-lg font-bold">Drag files here</p>
                    <p class="text-slate-500 text-sm">or click to browse from your device</p>
                </div>
                <div id="file-list"
                    class="hidden flex-col items-center gap-2 w-full max-h-32 overflow-y-auto scroller relative z-10 p-1">
                    <!-- File names will be inserted here -->
                </div>
                <div
                    class="mt-2 inline-flex items-center gap-2 rounded-full border border-slate-100 bg-white px-3 py-1 text-xs font-medium text-slate-400">
                    <span>Max file size: 5GB</span>
                </div>
                <input type="file" name="files" multiple id="file-input"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-0" />
            </div>
        </div>
    </div>
    <div class="p-6 sm:p-10 bg-white mt-2 pt-4">
        <button type="submit" id="submit-btn" disabled
            class="relative w-full overflow-hidden rounded-lg bg-primary hover:bg-[#0c3d4a] text-white font-bold h-12 shadow-lg shadow-primary/20 transition-all duration-300 transform active:scale-[0.99] flex items-center justify-center gap-2 group cursor-pointer z-10 relative disabled:opacity-50 disabled:cursor-not-allowed">
            <span>Upload Files</span>
            <span
                class="material-symbols-outlined text-[20px] transition-transform group-hover:-translate-y-1">arrow_upward</span>
        </button>
        <div class="mt-4 flex items-start gap-3 opacity-80">
            <span class="material-symbols-outlined text-[16px] text-slate-400 mt-0.5">info</span>
            <p class="text-xs text-slate-500 leading-normal">
                This is a private upload link. Do not share this URL with others.
            </p>
        </div>
    </div>
    <script>
        const dt = new DataTransfer();
        const fileInput = document.getElementById('file-input');
        const fileList = document.getElementById('file-list');
        const uploadPrompt = document.getElementById('upload-prompt');
        const submitBtn = document.getElementById('submit-btn');

        function renderFileList() {
            fileList.innerHTML = '';

            if (dt.files.length > 0) {
                submitBtn.disabled = false;
                uploadPrompt.classList.add('hidden');
                fileList.classList.remove('hidden');
                fileList.classList.add('flex');

                Array.from(dt.files).forEach((file, index) => {
                    const item = document.createElement('div');
                    item.className = 'w-full flex items-center justify-between bg-white border border-slate-200 rounded-xl px-4 py-3 shadow-sm hover:border-slate-300 transition-colors group relative z-20';

                    const leftDiv = document.createElement('div');
                    leftDiv.className = 'flex items-center gap-4 min-w-0 flex-1';

                    const iconDiv = document.createElement('div');
                    iconDiv.className = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 border border-blue-100 group-hover:bg-blue-100 transition-colors';
                    iconDiv.innerHTML = '<span class="material-symbols-outlined text-[20px]">draft</span>';

                    const infoDiv = document.createElement('div');
                    infoDiv.className = 'flex flex-col flex-1 min-w-0 text-left';
                    infoDiv.innerHTML = `
                        <p class="text-sm font-semibold text-slate-800 truncate">${file.name}</p>
                        <p class="text-xs text-slate-500 font-mono mt-0.5">${(file.size / 1024 / 1024).toFixed(2)} MB</p>
                    `;

                    leftDiv.appendChild(iconDiv);
                    leftDiv.appendChild(infoDiv);

                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'h-8 w-8 shrink-0 flex items-center justify-center rounded-full text-slate-400 hover:bg-red-50 hover:text-red-500 transition-colors cursor-pointer relative z-30';
                    removeBtn.innerHTML = '<span class="material-symbols-outlined text-[20px]">close</span>';
                    removeBtn.title = 'Remove file';
                    removeBtn.onclick = (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dt.items.remove(index);
                        fileInput.files = dt.files;
                        renderFileList();
                    };

                    item.appendChild(leftDiv);
                    item.appendChild(removeBtn);
                    fileList.appendChild(item);
                });
            } else {
                submitBtn.disabled = true;
                uploadPrompt.classList.remove('hidden');
                fileList.classList.add('hidden');
                fileList.classList.remove('flex');
            }
        }

        fileInput.addEventListener('change', function (e) {
            if (this.files && this.files.length > 0) {
                Array.from(this.files).forEach(file => {
                    let isDuplicate = false;
                    for (let i = 0; i < dt.files.length; i++) {
                        if (dt.files[i].name === file.name && dt.files[i].size === file.size && dt.files[i].lastModified === file.lastModified) {
                            isDuplicate = true;
                            break;
                        }
                    }
                    if (!isDuplicate) {
                        dt.items.add(file);
                    }
                });
            }

            this.files = dt.files;
            renderFileList();
        });
    </script>
</form>
{{end}}